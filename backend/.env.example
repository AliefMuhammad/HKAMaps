# ============================================================
# HKA MAPS — Inference Backend Environment Variables
# Copy to .env and fill in the values
# ============================================================

# ---------- Model paths (custom fine-tuned, optional) ----------
# Kosongkan jika ingin pakai HF model otomatis (direkomendasikan untuk MVP)
MODEL_ASSET_PATH=
MODEL_DEFECT_PATH=
MODEL_COMBINED_PATH=./models/combined_detector.pt
YOLO_PRETRAINED_FALLBACK=yolo11n.pt

# ---------- HuggingFace Road Damage Model (FREE, tidak perlu labeling) ----------
# Model YOLO12s yang sudah ditraining di RDD2022 (Japan, India, Norway road damage dataset)
# Tidak perlu akun HF, tidak perlu Roboflow, tidak perlu labeling manual
# Classes: D00 (retak memanjang), D10 (retak buaya), D20 (lubang), D40 (retak blok), Repair (tambalan)
USE_HF_DEFECT_MODEL=true
HF_DEFECT_MODEL_ID=rezzzq/yolo12s-road-damage-rdd2022
HF_DEFECT_FILENAME=yolo12s_RDD2022_best.pt
# HF_TOKEN=                 # Opsional — hanya untuk model private/gated di HuggingFace

# ---------- Zero-Shot Asset Detection (Grounding DINO, OPSIONAL) ----------
# Deteksi guardrail, traffic sign, dll via teks — tanpa training
# Perlu: pip install transformers torch
# Lebih lambat (~1-2s/frame CPU), cocok untuk video upload bukan realtime
USE_ZERO_SHOT_ASSETS=false
ZERO_SHOT_MODEL_ID=IDEA-Research/grounding-dino-tiny
ZERO_SHOT_ASSET_LABELS=guardrail,concrete barrier,traffic sign,direction sign,street light,toll gantry,cctv camera,delineator
ZERO_SHOT_THRESHOLD=0.28

# ---------- Inference thresholds ----------
CONFIDENCE_THRESHOLD_ASSET=0.40
CONFIDENCE_THRESHOLD_DEFECT=0.35
VIDEO_CONFIDENCE_THRESHOLD=0.40
INFERENCE_IMAGE_MAX_WIDTH=640

# ---------- Video processing ----------
VIDEO_FPS_SAMPLE=1.0               # sampled frames per second (default: 1 fps)
VIDEO_FRAME_INTERVAL_MS=1000
MAX_VIDEO_DURATION_SECONDS=600     # 10 minutes
MAX_VIDEO_FILE_SIZE_MB=500

# ---------- Duplicate filtering ----------
IOU_DUPLICATE_THRESHOLD=0.45
GPS_DUPLICATE_RADIUS_METERS=10.0
TIME_DUPLICATE_WINDOW_SECONDS=5.0

# ---------- Storage ----------
STORAGE_DIR=./storage
UPLOAD_DIR=./uploads

# ---------- Optional: Supabase direct upload from backend ----------
# Uncomment if you want the backend to upload annotated images to Supabase Storage
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# STORAGE_BUCKET_NAME=scan-photos

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
